{
  "name": "@codeberg/web-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser chat UI for the codeberg code-search agent (React + ai-sdk + streamdown)",
  "scripts": {
    "dev": "node scripts/canvas-assets.mjs && vite",
    "build": "node scripts/canvas-assets.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.6",
    "@excalidraw/excalidraw": "^0.18.1",
    "clsx": "^2.1.1",
