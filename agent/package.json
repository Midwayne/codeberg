{
  "name": "@codeberg/agent",
  "version": "0.1.0",
  "description": "Token-efficient code-search agent for codeberg-d via ai-sdk",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codeberg-ask": "./dist/cli.js",
    "codeberg-search": "./dist/search-cli.js",
    "codeberg-learning": "./dist/learning-cli.js",
    "codeberg-web": "./dist/web.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src web-ui/src --max-warnings 0",
    "test:lint": "node --test scripts/lint.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/google": "^4.0.87",
    "@ai-sdk/mcp": "^2.0.65",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "ai": "^7.0.126",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^10.12.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "source-map-js": "^1.2.2"
  }
}
