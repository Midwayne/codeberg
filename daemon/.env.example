# Copy to .env and adjust paths for your machine.

# Add projects in the browser; no repository setting is needed for startup.
# Internal keyed roots for advanced direct daemon/indexer runs:
# CODEBERG_ROOTS=$'api\t/path/to/api\nfrontend\t/path/to/frontend'

# Vector search (optional — omit both for chunk-only mode).
# Or set CODEBERG_VECTOR=false to disable embeddings even with CBERG_MODEL set.
# This omits search/hybrid_search; file, chunk, symbol, and graph tools remain.
# CODEBERG_VECTOR=false
# CBERG_INDEX_PATH is a base path: the actual index and its chunk-table/manifest
# sidecars are per-directory (<base>.<roothash>[.chunks|.manifest]), so changing
# project roots never reuse another tree's chunks and reverting reuses its cache.
CBERG_MODEL=models/jina-embeddings-v2-base-code/model.onnx
CBERG_INDEX_PATH=/tmp/codeberg.usearch

# usearch stored scalar kind for new index files (default: i8). Set f32 for
# maximum recall@k on fresh indexes; existing files keep their saved kind.
# CBERG_INDEX_QUANT=i8
# CBERG_INDEX_QUANT=f32

# Remote vector storage (optional — default is local usearch files above).
# CBERG_INDEX_BACKEND=qdrant
# CBERG_VECTORDB_URL=https://your-cluster.qdrant.io
# CBERG_VECTORDB_API_KEY=your-api-key
#
# CBERG_INDEX_BACKEND=pgvector
# CBERG_POSTGRES_URL=postgresql://user:pass@host:5432/dbname

# Embedding performance tuning (optional; passed through to cberg-index via inherited env):
# Cap ONNX intra-op threads; unset or <= 0 uses all physical cores.
# CBERG_EMBED_THREADS=8
# Rows per ONNX inference run (1..1024, default 16). Inputs are length-sorted, so
# small runs pad least on CPU; accelerators may prefer larger values.
# CBERG_EMBED_BATCH=16
# Apple Silicon only: 1 tries the CoreML execution provider (GPU/ANE). Helps
# fp16/fp32 models, but heavily-quantized (int8) models partition across CPU and
# are usually slower — measure before enabling. Default (unset) is CPU.
# CBERG_EMBED_COREML=1

# Watcher poll timeout in milliseconds (default: 1000)
# CBERG_POLL_MS=1000

# Each project's indexer socket is derived from its data directory.
# CBERG_SOCKET in the environment is not read.

# Path to cberg-index binary (default: beside codeberg-d or PATH)
# CBERG_INDEX_BIN=/path/to/cberg-index

# Embedding-model directory under each project's index/ (a single path segment).
# Empty keeps the historical un-namespaced index. The launcher sets this from
# the selected model.
# CODEBERG_INDEX_NAMESPACE=qwen3-mlx

# codeberg-d HTTP listen port (default: 48080)
# CODEBERG_HTTP_PORT=48080

# How long a project may take to become ready (Go duration). Invalid values
# fail startup. Default is 5 minutes per repo, bounded to 15–60 minutes.
# CODEBERG_HEALTH_TIMEOUT=30m

# Periodic git pull for mirror refresh; 0 or unset = disabled.
# Every served root that contains a .git directory is pulled.
# CODEBERG_GIT_PULL_INTERVAL_SEC=300

# The agent (codeberg-ask / codeberg-web) is configured separately
# in agent/.env — the daemon does not use an LLM API key. See agent/.env.example.
